{
  "name": "meac-wind",
  "version": "0.1.0",
  "description": "TypeScript client for fetching and parsing public MEAC wind page data",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "wind",
    "weather",
    "meac",
    "scraper",
    "wind-measurement",
    "meteorology",
    "typescript"
  ],
  "author": "thejoltjoker",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thejoltjoker/meac-wind.git"
  },
  "bugs": {
    "url": "https://github.com/thejoltjoker/meac-wind/issues"
  },
  "homepage": "https://github.com/thejoltjoker/meac-wind#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "linkedom": "^0.18.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "4.1.8",
    "typescript": "^5.7.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
